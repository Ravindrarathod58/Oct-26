							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "-> An Armstrong number (also known as a Narcissistic number or Pluperfect Digital Invariant) is a number that"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "    is equal to the sum of its own digits each raised to the power of the number of digits."
								}
							]
						},
