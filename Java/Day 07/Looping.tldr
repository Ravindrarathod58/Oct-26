							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": " Write  program to check given number is automorphic number or not "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Automorphic number :"
								}
							]
						},
