							"content": [
								{
									"type": "text",
									"text": "Write a C program that takes the time of day as input (in hours) and prints whether it is morning, afternoon, evening, or night using an if statement."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "-categorize the time of day into four categories:"
								}
