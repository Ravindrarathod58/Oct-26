											"type": "bold"
										}
									],
									"text": "        System.out.println(\"Enter the month number (1-12)\");"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "        int month = sc.nextInt(); // 30 31 28 29"
